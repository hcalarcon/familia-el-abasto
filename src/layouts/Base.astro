---
interface Props {
  titulo: string;
  descripcion: string;
  /** Mientras la web esté en construcción no queremos que Google la indexe a medias. */
  indexar?: boolean;
}
const { titulo, descripcion, indexar = true } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {!indexar && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1c211e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Caveat:wght@600&family=Work+Sans:wght@400;600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --pizarron: #1c211e;
    --papel: #f4eee3;
    --tarjeta: #fffaf2;
    --vino: #7d2a33;
    --dorado: #e3b766;
    --texto-suave: #4a4f4b;
    --fuente-titulo: 'Alfa Slab One', Georgia, serif;
    --fuente-texto: 'Work Sans', system-ui, sans-serif;
    --fuente-mano: 'Caveat', cursive;
    color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--pizarron);
    color: var(--papel);
    font-family: var(--fuente-texto);
    font-size: 1rem;
    line-height: 1.55;
    overflow-wrap: break-word;
  }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--dorado); outline-offset: 3px; }
  .visualmente-oculto {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; animation: none !important; }
  }
</style>
