---
// Entrada del QR impreso en los folletos. ESTA RUTA NO SE CAMBIA NUNCA.
// Todo el texto sale de src/contenido/ (sitio.json y cartas.json), editable desde Pages CMS.
import Base from '../layouts/Base.astro';
import { sitio, cartas, esPendiente, linkTelefono, linkMapa } from '../lib/contenido';
import { obtenerNotas, obtenerPaginas } from '../lib/publicaciones';
import { datosDelGrupo } from '../lib/seo';

const [paginas, notas] = await Promise.all([obtenerPaginas(), obtenerNotas()]);

// Los datos entre corchetes siguen pendientes: no se muestran en la web.
const mostrar = (valor: string | undefined) => (esPendiente(valor) ? '' : (valor ?? '').trim());

// El botón de historia solo se muestra si su link existe (evita mandar a un 404).
const rutasInternas = new Set(['/', '/cartas', ...paginas.map((p) => `/${p.id}`), ...(notas.length ? ['/blog'] : [])]);
const historiaLink = mostrar(cartas.historiaLink).replace(/(.)\/$/, '$1');
const mostrarHistoria = !!historiaLink && (!historiaLink.startsWith('/') || rutasInternas.has(historiaLink));

const locales = sitio.locales.map((local) => {
  const tel = linkTelefono(local.telefono);
  const zapan = mostrar(local.zapan);
  const direccion = mostrar(local.direccion);
  return {
    nombre: local.nombre,
    linea: mostrar(local.linea),
    foto: mostrar(local.foto),
    fotoAlt: mostrar(local.fotoAlt),
    logo: mostrar(local.logo),
    logoAlt: mostrar(local.logoAlt),
    textoMenu: mostrar(local.textoMenu) || 'Ver menú',
    menu: mostrar(local.menu),
    zapan,
    telefono: mostrar(local.telefono),
    tel,
    // En el chip va la calle; la ciudad ya está en toda la página.
    calle: direccion.split(',')[0].trim(),
    mapa: linkMapa(local),
    // Con Zapan, el segundo botón es "Pedir en Zapan". Sin Zapan, "Reservar" llama al teléfono.
    reservar: !zapan && tel,
  };
});

const redes = sitio.locales
  .map((local) => ({ nombre: mostrar(local.nombreCorto) || local.nombre, completo: local.nombre, url: mostrar(local.instagram) }))
  .filter((r) => r.url);

const dominio = mostrar(sitio.dominio);
const logo = mostrar(sitio.logo);
const nombres = sitio.locales.map((l) => l.nombre).join(', ').replace(/, ([^,]*)$/, ' y $1');
---
<Base
  titulo={`Cartas y reservas · ${nombres} · ${sitio.ciudad}`}
  descripcion={`Menús, pedidos y reservas de ${nombres} en ${sitio.ciudad}. ${mostrar(sitio.lema)}.`}
  imagen={locales[0]?.foto || undefined}
  datosEstructurados={datosDelGrupo(Astro.site)}
  tema="papel"
>
  <header class="portada">
    {logo && <img class="portada__logo" src={logo} alt={mostrar(sitio.logoAlt)} width="120" height="112" />}
    <h1>{sitio.nombre}</h1>
    {mostrar(sitio.lema) && <p class="portada__lema">{sitio.lema}</p>}
    {mostrar(sitio.firma) && <p class="portada__firma">{sitio.firma}</p>}

    {redes.length > 0 && (
      <nav class="redes" aria-label={mostrar(cartas.tituloRedes) || 'Redes'}>
        <ul role="list">
          {redes.map((r) => (
            <li>
              <a href={r.url} rel="noopener">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
                {r.nombre}<span class="visualmente-oculto"> en Instagram ({r.completo})</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </header>

  <main class="cuerpo">
    <section aria-labelledby="titulo-locales">
      <h2 id="titulo-locales" class="etiqueta">{mostrar(cartas.tituloLocales) || 'Elegí tu restaurante'}</h2>
      <ul class="locales" role="list">
        {locales.map((local, i) => (
          <li>
            <article class="local" aria-labelledby={`local-${i}`}>
              {local.foto && (
                <img
                  class="local__foto"
                  src={local.foto}
                  alt={local.fotoAlt}
                  width="1042"
                  height="386"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                />
              )}
              <div class="local__cuerpo">
                <div class="local__encabezado">
                  {local.logo && <img class="local__logo" src={local.logo} alt={local.logoAlt} width="56" height="56" loading={i === 0 ? 'eager' : 'lazy'} />}
                  <div>
                    <h3 id={`local-${i}`}>{local.nombre}</h3>
                    {local.linea && <p class="local__linea">{local.linea}</p>}
                  </div>
                </div>

                {local.mapa && (
                  <address class="local__ubicacion">
                    <a class="chip" href={local.mapa} rel="noopener">
                      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                      {local.calle}<span class="visualmente-oculto">: ver {local.nombre} en Google Maps</span>
                    </a>
                  </address>
                )}

                {(local.menu || local.zapan || local.reservar) && (
                  <div class="local__acciones">
                    {local.menu && (
                      <a class="boton boton--oscuro" href={local.menu} rel="noopener">
                        {local.textoMenu}<span class="visualmente-oculto"> de {local.nombre}</span>
                      </a>
                    )}
                    {local.zapan && (
                      <a class="boton boton--vino" href={local.zapan} rel="noopener">
                        Pedir en Zapan<span class="visualmente-oculto">: {local.nombre}</span>
                      </a>
                    )}
                    {local.reservar && (
                      <a class="boton boton--borde" href={local.tel as string}>
                        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
                        <span>Reservar<span class="boton__dato">{local.telefono}</span></span>
                        <span class="visualmente-oculto"> en {local.nombre}</span>
                      </a>
                    )}
                  </div>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>

    {mostrarHistoria && (
      <a class="historia" href={historiaLink}>
        <span>
          <span class="historia__titulo">{cartas.historiaTitulo}</span>
          {mostrar(cartas.historiaBajada) && <span class="historia__bajada">{cartas.historiaBajada}</span>}
        </span>
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    )}
  </main>

  <footer class="pie">
    <p>{dominio ? `${dominio} · ${sitio.ciudad}` : sitio.ciudad}</p>
  </footer>
</Base>

<style>
  .portada {
    background: var(--pizarron);
    color: var(--papel);
    text-align: center;
    padding: 2.5rem 1rem 2rem;
  }
  .portada__logo { display: block; width: 120px; height: auto; margin: 0 auto 1.25rem; }
  h1 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: clamp(1.9rem, 9vw, 3rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .portada__lema {
    max-width: 22rem;
    margin: 0.75rem auto 0;
    font-size: 1.0625rem;
    color: rgb(244 238 227 / 0.85);
    text-wrap: balance;
  }
  .portada__firma {
    margin: 1.1rem 0 0;
    font-family: var(--fuente-mano);
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--dorado);
  }

  .redes ul {
    list-style: none;
    margin: 1.5rem auto 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .redes a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 1px solid rgb(227 183 102 / 0.55);
    border-radius: 999px;
    color: var(--papel);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .redes a:is(:hover, :focus-visible) { background: rgb(227 183 102 / 0.12); border-color: var(--dorado); }

  /* Foco visible: sobre el pizarrón de la portada, dorado (el vino del tema papel casi no se ve). */
  .portada :focus-visible { outline-color: var(--dorado); }
  .redes a:focus-visible { outline: 3px solid var(--dorado); outline-offset: 3px; }

  .cuerpo {
    background: var(--papel);
    color: var(--pizarron);
    padding: 1.75rem 1rem 1rem;
  }
  .cuerpo > * { max-width: 68rem; margin-inline: auto; }

  .etiqueta {
    margin-top: 0;
    margin-bottom: 0.9rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .locales {
    list-style: none;
    padding: 0;
    margin-top: 0;
    margin-bottom: 1.25rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }
  .locales > li { display: flex; }
  .local {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--tarjeta);
    border: 1px solid #e4dccd;
    border-radius: 0.9rem;
    overflow: hidden;
  }
  .local__foto {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 27 / 10;
    object-fit: cover;
    background: #2a302c;
  }
  .local__cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.1rem 1.1rem 1.25rem;
  }
  .local__encabezado { display: flex; align-items: center; gap: 0.9rem; }
  .local__logo { flex: none; width: 56px; height: 56px; border-radius: 50%; }
  h3 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .local__linea { margin: 0.3rem 0 0; color: var(--texto-suave); }

  .local__ubicacion { font-style: normal; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 36px;
    padding: 0.3rem 0.8rem 0.3rem 0.6rem;
    border-radius: 999px;
    background: #efe6d6;
    color: var(--vino);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .chip:is(:hover, :focus-visible) { background: #e6d9c3; }
  .chip:focus-visible { outline: 3px solid var(--vino); outline-offset: 3px; }

  .local__acciones {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: 0.6rem;
  }

  /* Con subgrid, las tarjetas de una misma fila comparten filas: foto, encabezado, ubicación y botones
     quedan a la misma altura aunque un local tenga logo o una línea más larga. Sin subgrid, queda el
     flex de arriba (los botones igual van abajo de todo por el margin-top: auto).
     Va después de .local y .local__cuerpo para pisar su display: flex (misma especificidad). */
  @supports (grid-template-rows: subgrid) {
    .locales > li {
      display: grid;
      grid-row: span 4;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    .local {
      display: grid;
      grid-row: 1 / -1;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    .local__foto { grid-row: 1; }
    .local__cuerpo {
      display: grid;
      grid-row: 2 / -1;
      grid-template-rows: subgrid;
      row-gap: 0.85rem;
      align-content: start;
    }
    .local__encabezado { grid-row: 1; align-self: start; }
    .local__ubicacion { grid-row: 2; }
    /* Abajo de todo lo sigue empujando el margin-top: auto (align-self: end lo achicaba en Chrome). */
    .local__acciones { grid-row: 3; }
  }
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.5rem;
    border-radius: 0.6rem;
    border: 2px solid transparent;
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    line-height: 1.2;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .boton--oscuro { background: var(--pizarron); color: var(--papel); }
  .boton--oscuro:is(:hover, :focus-visible) { background: #333a35; }
  .boton--vino { background: var(--vino); color: var(--papel); }
  .boton--vino:is(:hover, :focus-visible) { background: var(--vino-oscuro); }
  .boton--borde { border-color: var(--pizarron); color: var(--pizarron); background: transparent; }
  .boton--borde:is(:hover, :focus-visible) { background: var(--pizarron); color: var(--papel); }
  .boton:focus-visible { outline: 3px solid var(--vino); outline-offset: 3px; }
  /* El teléfono no se parte en dos renglones. */
  .boton__dato { display: block; font-size: 0.8125rem; font-weight: 400; white-space: nowrap; }

  .historia {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1.1rem 1.25rem;
    background: var(--pizarron);
    color: var(--papel);
    border-radius: 0.9rem;
    text-decoration: none;
  }
  .historia:is(:hover, :focus-visible) svg { transform: translateX(3px); }
  /* El contorno cae afuera del recuadro, sobre el papel: ahí el que se ve es el vino (el dorado no). */
  .historia:focus-visible { outline: 3px solid var(--vino); outline-offset: 3px; }
  .historia svg { flex: none; transition: transform 0.15s ease; }
  .historia__titulo { display: block; font-family: var(--fuente-titulo); font-size: 1.35rem; line-height: 1.2; }
  .historia__bajada { display: block; margin-top: 0.15rem; color: rgb(244 238 227 / 0.85); }

  .pie {
    background: var(--papel);
    color: var(--texto-suave);
    text-align: center;
    padding: 1rem 1rem 2.5rem;
    font-size: 0.875rem;
  }
  .pie p { margin: 0; }

  @media (min-width: 48rem) {
    .portada { padding-block: 3.5rem 2.75rem; }
    .cuerpo { padding-top: 2.5rem; }
  }
</style>
