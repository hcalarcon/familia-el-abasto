---
// Carta de Las Barricas del Abasto. Se trae de smaalacarta al compilar (src/lib/carta.ts):
// la carta se edita en smaalacarta, no en este repo. En dev, si la API falla, se ve la carta de ejemplo.
import Base from '../layouts/Base.astro';
import { sitio, esPendiente, linkTelefono } from '../lib/contenido';
import { obtenerCarta, rutaDeCarta, textoPrecio } from '../lib/carta';
import { datosDeCarta } from '../lib/seo';

// Los datos entre corchetes siguen pendientes: no se muestran en la web.
const mostrar = (valor: string | null | undefined) => (esPendiente(valor ?? undefined) ? '' : (valor ?? '').trim());

const local = sitio.locales.find((l) => rutaDeCarta(l.cartaSlug) === '/barricas');
if (!local) throw new Error('Ningún local de sitio.json tiene un cartaSlug que lleve a /barricas.');

const carta = await obtenerCarta(local.cartaSlug);

const ciudad = mostrar(local.ciudad) || sitio.ciudad;
const direccion = mostrar(local.direccion);
const calle = direccion.split(',')[0].trim();
const horario = mostrar(local.horario);
const datoLinea = [calle, horario].filter(Boolean).join(' · ');
const logo = mostrar(local.logo);
const tel = linkTelefono(local.telefono);
const telefono = mostrar(local.telefono);

// Ids de las categorías: slug sin tildes, sin repetir.
const usados = new Set<string>();
function idDe(texto: string): string {
  const base =
    texto
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '') || 'categoria';
  let id = base;
  for (let n = 2; usados.has(id); n++) id = `${base}-${n}`;
  usados.add(id);
  return id;
}

const categorias = carta.categorias
  .map((c) => ({
    nombre: mostrar(c.nombre),
    descripcion: mostrar(c.descripcion),
    platos: c.platos
      .filter((p) => mostrar(p.nombre))
      .map((p) => ({
        nombre: mostrar(p.nombre),
        descripcion: mostrar(p.descripcion),
        precio: textoPrecio(p.precio),
        conPrecio: typeof p.precio === 'number',
        foto: mostrar(p.foto),
        agotado: p.agotado === true,
      })),
  }))
  .filter((c) => c.nombre && c.platos.length)
  .map((c) => ({ ...c, id: idDe(c.nombre) }));

const titulo = `Carta de ${local.nombre}`;
const descripcion = `${titulo} en ${ciudad}: platos y precios. ${
  calle ? `${calle}. ` : ''
}Reservas por teléfono.`;
---
<Base
  titulo={`${titulo} · ${ciudad}`}
  descripcion={descripcion}
  imagen={mostrar(local.foto) || undefined}
  datosEstructurados={datosDeCarta(carta, local, Astro.site)}
  tema="papel"
>
  <header class="portada">
    <a class="portada__volver" href="/cartas">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
      Las cartas
    </a>
    {logo && <img class="portada__logo" src={logo} alt={mostrar(local.logoAlt)} width="72" height="72" />}
    <h1>{titulo}</h1>
    {datoLinea && <p class="portada__dato">{datoLinea}</p>}
  </header>

  {categorias.length > 1 && (
    <nav class="categorias" aria-label="Categorías">
      <ul role="list">
        {categorias.map((c) => (
          <li><a class="chip" href={`#${c.id}`}>{c.nombre}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {/* En celular y tablet este contenedor no hace nada; en escritorio arma las dos columnas. */}
  <div class="cuerpo">
    {categorias.length > 1 && (
      <nav class="indice" aria-label="Categorías">
        <p class="indice__titulo" aria-hidden="true">En la carta</p>
        <ul role="list">
          {categorias.map((c) => (
            <li><a href={`#${c.id}`}>{c.nombre}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <main class="carta">
      {categorias.map((c) => (
        <section class="categoria" id={c.id} aria-labelledby={`titulo-${c.id}`}>
          <h2 id={`titulo-${c.id}`}>{c.nombre}</h2>
          {c.descripcion && <p class="categoria__descripcion">{c.descripcion}</p>}
          <ul class="platos" role="list">
            {c.platos.map((p) => (
              <li class:list={['plato', { 'plato--agotado': p.agotado, 'plato--con-foto': p.foto }]}>
                {p.foto && (
                  <img class="plato__foto" src={p.foto} alt={p.nombre} width="64" height="64" loading="lazy" decoding="async" />
                )}
                <div class="plato__texto">
                  <h3 class="plato__nombre">
                    <span class="plato__titulo"><span class="plato__atenuable">{p.nombre}</span>{p.agotado && <span class="plato__agotado">Agotado</span>}</span>
                  </h3>
                  {p.descripcion && <p class="plato__descripcion plato__atenuable">{p.descripcion}</p>}
                </div>
                <p class="plato__precio plato__atenuable">
                  {p.agotado && p.conPrecio ? (
                    <s><span class="visualmente-oculto">Precio habitual: </span>{p.precio}</s>
                  ) : (
                    <>
                      <span class="visualmente-oculto">Precio: </span>
                      {p.precio}
                    </>
                  )}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <div class="acciones">
        {tel && (
          <a class="boton boton--borde" href={tel}>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
            <span>Reservar<span class="boton__dato">{telefono}</span></span>
            <span class="visualmente-oculto"> en {local.nombre}</span>
          </a>
        )}
        <a class="boton boton--oscuro" href="/cartas">Volver a las cartas</a>
      </div>
    </main>
  </div>

  <footer class="pie">
    <p>{[local.nombre, ciudad].join(' · ')}</p>
  </footer>
</Base>

<script>
  // Escritorio: el índice de la izquierda marca la categoría que se está leyendo.
  // Sin JS (o sin IntersectionObserver) queda como lista de anclas común.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.indice a')].map((a) => [a.hash.slice(1), a]));
  const secciones = [...document.querySelectorAll<HTMLElement>('.categoria')].filter((s) => links.has(s.id));

  if (secciones.length && 'IntersectionObserver' in window) {
    // La actual es la última categoría cuyo comienzo ya pasó una línea imaginaria en la parte de arriba
    // de la pantalla (35 % del alto, hasta 320 px: en pantallas muy altas no baja de más).
    const linea = () => Math.min(window.innerHeight * 0.35, 320);
    let marcada: string | undefined;

    const actualizar = () => {
      const alto = document.documentElement.scrollHeight;
      // Arriba de todo, la primera; al llegar al final, la última (quizá nunca alcanza la línea).
      const actual =
        window.scrollY < 1
          ? secciones[0]
          : window.innerHeight + window.scrollY >= alto - 2
            ? secciones[secciones.length - 1]
            : secciones.filter((s) => s.getBoundingClientRect().top <= linea()).pop();
      if (actual?.id === marcada) return;
      marcada = actual?.id;
      links.forEach((a, id) => (id === marcada ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };

    // Los observadores solo avisan cuándo recalcular: cuando una categoría cruza la línea o asoma el pie.
    let porLinea: IntersectionObserver | undefined;
    const observar = () => {
      porLinea?.disconnect();
      porLinea = new IntersectionObserver(actualizar, { rootMargin: `0px 0px ${linea() - window.innerHeight}px 0px` });
      secciones.forEach((s) => porLinea?.observe(s));
    };
    observar();
    let espera: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(espera);
      espera = window.setTimeout(observar, 200);
    });
    const pie = document.querySelector('.pie');
    if (pie) new IntersectionObserver(actualizar, { threshold: [0, 1] }).observe(pie);
  }
</script>

<style>
  /* Portada pizarrón, más baja que la de /cartas: acá lo importante es la carta. */
  .portada {
    position: relative;
    background: var(--pizarron);
    color: var(--papel);
    text-align: center;
    padding: 3.25rem 1rem 1.6rem;
  }
  .portada__volver {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    color: rgb(244 238 227 / 0.85);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .portada__volver:is(:hover, :focus-visible) { background: rgb(227 183 102 / 0.12); color: var(--papel); }
  .portada :focus-visible { outline: 3px solid var(--dorado); outline-offset: 3px; }
  .portada__logo { display: block; width: 72px; height: 72px; margin: 0 auto 0.9rem; border-radius: 50%; }
  h1 {
    margin: 0 auto;
    max-width: 44rem;
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: clamp(1.6rem, 7.5vw, 2.5rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .portada__dato {
    margin: 0.6rem auto 0;
    max-width: 26rem;
    font-size: 0.9375rem;
    color: rgb(244 238 227 / 0.85);
    text-wrap: balance;
  }

  /* Navegación por categorías: chips que se deslizan de costado y quedan pegados arriba al bajar. */
  .categorias {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--papel);
    border-bottom: 1px solid #e4dccd;
  }
  .categorias ul {
    list-style: none;
    margin: 0 auto;
    max-width: 44rem;
    padding: 0.6rem 1rem;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /* Se esfuma el borde derecho: avisa que hay más chips. */
    mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent);
  }
  .categorias ul::-webkit-scrollbar { display: none; }
  .categorias li { flex: none; }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: #efe6d6;
    color: var(--vino);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .chip:is(:hover, :focus-visible) { background: #e6d9c3; }
  .chip:focus-visible { outline: 3px solid var(--vino); outline-offset: -3px; }

  .carta {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0.5rem 1rem 1rem;
    color: var(--pizarron);
  }
  @media (prefers-reduced-motion: no-preference) { :global(html) { scroll-behavior: smooth; } }

  .categoria {
    /* Alto del sticky (~3.6rem) + aire: el título no queda tapado al saltar con un chip. */
    scroll-margin-top: 4.5rem;
    padding-top: 1.5rem;
  }
  h2 {
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--pizarron);
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .categoria__descripcion { margin: 0.6rem 0 0; color: var(--texto-suave); font-size: 0.9375rem; }

  .platos { list-style: none; margin: 0; padding: 0; }
  .plato {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    align-items: start;
    padding: 0.85rem 0;
    border-bottom: 1px solid #e4dccd;
  }
  .plato:last-child { border-bottom: 0; }
  .plato--con-foto { grid-template-columns: 64px 1fr auto; column-gap: 0.85rem; }
  .plato__foto {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 0.5rem;
    background: #e4dccd;
  }
  .plato__texto { min-width: 0; }
  .plato__nombre {
    margin: 0;
    font-family: var(--fuente-texto);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .plato__descripcion { margin: 0.2rem 0 0; color: var(--texto-suave); font-size: 0.9375rem; line-height: 1.45; }
  .plato__precio {
    margin: 0;
    font-weight: 600;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-align: right;
  }

  /* Agotado: se atenúa el plato, pero la etiqueta queda con contraste pleno. */
  .plato--agotado .plato__atenuable,
  .plato--agotado .plato__foto { opacity: 0.55; }
  .plato--agotado .plato__foto { filter: grayscale(1); }
  .plato__agotado {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--vino);
    color: var(--papel);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 0.1em;
    white-space: nowrap;
  }

  .acciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0.5rem;
    border-radius: 0.6rem;
    border: 2px solid transparent;
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    line-height: 1.2;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .boton--oscuro { background: var(--pizarron); color: var(--papel); }
  .boton--oscuro:is(:hover, :focus-visible) { background: #333a35; }
  .boton--borde { border-color: var(--pizarron); color: var(--pizarron); background: transparent; }
  .boton--borde:is(:hover, :focus-visible) { background: var(--pizarron); color: var(--papel); }
  .boton:focus-visible { outline: 3px solid var(--vino); outline-offset: 3px; }
  .boton__dato { display: block; font-size: 0.8125rem; font-weight: 400; white-space: nowrap; }

  .pie {
    color: var(--texto-suave);
    text-align: center;
    padding: 1.25rem 1rem 2.5rem;
    font-size: 0.875rem;
  }
  .pie p { margin: 0; }

  @media (min-width: 48rem) {
    .portada { padding-block: 3rem 2rem; }
    .portada__volver { top: 1rem; left: 1rem; }
    .categorias ul { mask-image: none; flex-wrap: wrap; }
    h2 { font-size: 1.75rem; }
    .plato { padding-block: 1rem; }
  }

  /* El índice lateral es solo para escritorio. */
  .indice { display: none; }

  /* Escritorio: índice de categorías fijo a la izquierda y la carta a la derecha. */
  @media (min-width: 64rem) {
    .categorias { display: none; }

    .cuerpo {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      column-gap: 4rem;
      max-width: 68.75rem;
      margin: 0 auto;
      padding: 1.5rem 1.5rem 0;
    }

    .indice {
      display: block;
      position: sticky;
      top: 1.5rem;
      align-self: start;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      /* Alinea el título del índice con el primer título de la carta. */
      padding-top: 1.5rem;
      scrollbar-width: thin;
    }
    .indice__titulo {
      margin: 0 0 0.75rem;
      padding-top: 0.35rem;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--texto-suave);
    }
    .indice ul {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 1px solid #e4dccd;
    }
    .indice a {
      display: block;
      margin-left: -1px;
      padding: 0.4rem 0.75rem 0.4rem 1rem;
      border-left: 3px solid transparent;
      color: var(--texto-suave);
      font-size: 0.9375rem;
      line-height: 1.3;
      text-decoration: none;
    }
    .indice a:hover { color: var(--pizarron); border-left-color: #c9bba3; }
    .indice a:focus-visible { outline: 3px solid var(--vino); outline-offset: -3px; }
    .indice a[aria-current='true'] { color: var(--vino); border-left-color: var(--vino); font-weight: 600; }

    .carta { max-width: none; margin: 0; padding: 0 0 1rem; }
    /* Sin la barra de chips arriba, el salto deja el título casi pegado al borde. */
    .categoria { scroll-margin-top: 0; }

    /* Puntos guía entre el nombre y el precio, sobre la línea base del renglón.
       Solo ocupan el espacio que sobra: si el nombre necesita dos renglones o más, no aparecen
       (un tramito de puntos colgado al final del primer renglón queda desprolijo). */
    .plato { column-gap: 0.5rem; }
    .plato__nombre { display: flex; align-items: first baseline; }
    .plato__titulo { flex: 0 1 auto; min-width: 0; }
    .plato__nombre::after {
      content: '';
      flex: 1 1 0;
      min-width: 0;
      margin-left: 0.5rem;
      border-bottom: 1px dotted #b3a78f;
    }
    .plato--agotado .plato__nombre::after { opacity: 0.55; }

    .acciones {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 16rem));
      margin-top: 2.5rem;
    }
  }
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .indice a { transition: color 0.15s ease, border-color 0.15s ease; }
  }
</style>
