---
import { rutaLimpia } from '../../lib/rutas';
// Notas del blog que crea el admin desde el panel (src/contenido/blog/*.md).
import { render } from 'astro:content';
import Contenido from '../../layouts/Contenido.astro';
import Articulo from '../../componentes/Articulo.astro';
import { obtenerNotas, formatearFecha, fechaISO, type Nota } from '../../lib/publicaciones';
import { sitio } from '../../lib/contenido';
import { datosDeNota } from '../../lib/seo';

export async function getStaticPaths() {
  const notas = await obtenerNotas();
  return notas.map((nota) => ({ params: { slug: nota.id }, props: { nota } }));
}

const { nota } = Astro.props as { nota: Nota };
const { Content } = await render(nota);
const { titulo, descripcion, fecha, imagen, imagenAlt } = nota.data;
const url = Astro.site ? new URL(rutaLimpia(Astro.url.pathname), Astro.site).href : undefined;
const imagenAbsoluta = imagen && Astro.site ? new URL(imagen, Astro.site).href : undefined;
---
<Contenido
  titulo={`${titulo} · ${sitio.nombre}`}
  descripcion={descripcion}
  imagen={imagen || undefined}
  tipo="article"
  datosEstructurados={datosDeNota({ titulo, descripcion, fecha: fechaISO(fecha), url, imagen: imagenAbsoluta })}
>
  <Articulo titulo={titulo} imagen={imagen || undefined} imagenAlt={imagenAlt}>
    <a slot="antes-del-titulo" class="volver" href="/blog">Volver al blog</a>
    <p slot="despues-del-titulo" class="fecha"><time datetime={fechaISO(fecha)}>{formatearFecha(fecha)}</time></p>
    <Content />
  </Articulo>
</Contenido>

<style>
  .volver {
    display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 0.5rem;
    font-weight: 600; color: var(--vino);
  }
  .fecha { margin: 0 0 1rem; color: var(--texto-suave); }
</style>
