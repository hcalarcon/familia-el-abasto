---
// Pantalla provisoria "en construcción", compartida por / y /menus.
// Sigue el estilo de la entrada del QR del diseño aprobado. Todo el texto sale de src/contenido/.
import Base from '../layouts/Base.astro';
import { sitio, enConstruccion, esPendiente, linkTelefono } from '../lib/contenido';
import { obtenerNotas } from '../lib/publicaciones';
import { datosDelGrupo } from '../lib/seo';

interface Props {
  /** "inicio" para /, "menus" para /menus (la entrada del QR). */
  pantalla: 'inicio' | 'menus';
}
const { pantalla } = Astro.props;
const notas = await obtenerNotas();

// Los datos entre corchetes siguen pendientes: no se muestran en la web.
const mostrar = (valor: string | undefined) => (esPendiente(valor) ? '' : (valor ?? '').trim());

const locales = sitio.locales.map((local) => {
  const tel = linkTelefono(local.telefono);
  const zapan = mostrar(local.zapan);
  return {
    nombre: local.nombre,
    linea: mostrar(local.linea),
    foto: mostrar(local.foto),
    fotoAlt: mostrar(local.fotoAlt),
    logo: mostrar(local.logo),
    logoAlt: mostrar(local.logoAlt),
    textoMenu: mostrar(local.textoMenu) || 'Ver menú',
    menu: mostrar(local.menu),
    zapan,
    telefono: mostrar(local.telefono),
    tel,
    // Si hay Zapan, el segundo botón es "Pedir en Zapan" y el teléfono va como texto.
    // Si no, el segundo botón es "Reservar" con el teléfono a la vista.
    reservar: !zapan && tel,
  };
});

const redes = sitio.locales
  .map((local) => ({ nombre: mostrar(local.nombreCorto) || local.nombre, completo: local.nombre, url: mostrar(local.instagram) }))
  .filter((r) => r.url);

const dominio = mostrar(sitio.dominio);
const logo = mostrar(sitio.logo);
---
<Base
  titulo={pantalla === 'menus' ? `Menús · ${sitio.nombre}` : `${sitio.nombre} · ${sitio.ciudad}`}
  descripcion={`${sitio.lema}. ${sitio.historia}`}
  imagen={locales[0]?.foto || undefined}
  datosEstructurados={datosDelGrupo(Astro.site)}
>
  <header class="portada">
    {logo && <img class="portada__logo" src={logo} alt={mostrar(sitio.logoAlt)} width="120" height="112" />}
    <h1>{sitio.nombre}</h1>
    <p class="portada__lema">{sitio.lema}</p>
    {mostrar(sitio.firma) && <p class="portada__firma">{sitio.firma}</p>}
    {mostrar(enConstruccion.aviso) && <p class="portada__aviso">{enConstruccion.aviso}</p>}
  </header>

  <main class="cuerpo">
    <h2 class="etiqueta">{enConstruccion.tituloLocales}</h2>
    <ul class="locales" role="list">
      {locales.map((local, i) => (
        <li class="local">
          {local.foto && (
            <img
              class="local__foto"
              src={local.foto}
              alt={local.fotoAlt}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
            />
          )}
          <div class="local__cuerpo">
            <div class="local__encabezado">
              {local.logo && <img class="local__logo" src={local.logo} alt={local.logoAlt} width="56" height="56" loading="lazy" />}
              <div>
                <h3>{local.nombre}</h3>
                {local.linea && <p class="local__linea">{local.linea}</p>}
                {!local.reservar && local.telefono && (
                  <p class="local__linea">
                    Tel. {local.tel ? <a href={local.tel}>{local.telefono}</a> : local.telefono}
                  </p>
                )}
              </div>
            </div>
            {(local.menu || local.zapan || local.reservar) && (
              <div class="local__acciones">
                {local.menu && (
                  <a class="boton boton--oscuro" href={local.menu} rel="noopener">
                    {local.textoMenu}<span class="visualmente-oculto"> de {local.nombre}</span>
                  </a>
                )}
                {local.zapan && (
                  <a class="boton boton--vino" href={local.zapan} rel="noopener">
                    Pedir en Zapan<span class="visualmente-oculto">: {local.nombre}</span>
                  </a>
                )}
                {local.reservar && (
                  <a class="boton boton--borde" href={local.tel as string}>
                    {`Reservar: ${local.telefono}`}<span class="visualmente-oculto"> en {local.nombre}</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>

    {mostrar(enConstruccion.historiaLink) && (
      <a class="historia" href={enConstruccion.historiaLink}>
        <span>
          <span class="historia__titulo">{enConstruccion.historiaTitulo}</span>
          <span class="historia__bajada">{enConstruccion.historiaBajada}</span>
        </span>
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    )}

    {notas.length > 0 && (
      <p class="blog"><a href="/blog">Leé nuestro blog</a></p>
    )}

    {redes.length > 0 && (
      <section aria-labelledby="titulo-redes">
        <h2 id="titulo-redes" class="etiqueta">{enConstruccion.tituloRedes}</h2>
        <ul class="redes" role="list">
          {redes.map((r) => (
            <li>
              <a href={r.url} rel="noopener">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
                {r.nombre}<span class="visualmente-oculto"> en Instagram ({r.completo})</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <footer class="pie">
    <p>{dominio ? `${dominio} · ${sitio.ciudad}` : sitio.ciudad}</p>
  </footer>
</Base>

<style>
  .portada {
    background: var(--pizarron);
    color: var(--papel);
    text-align: center;
    padding: 2.5rem 1rem 2.25rem;
  }
  .portada__logo { display: block; width: 120px; height: auto; margin: 0 auto 1.25rem; }
  h1 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: clamp(1.9rem, 9vw, 3rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .portada__lema {
    max-width: 22rem;
    margin: 0.75rem auto 0;
    font-size: 1.0625rem;
    color: rgb(244 238 227 / 0.85);
    text-wrap: balance;
  }
  .portada__firma {
    margin: 1.25rem 0 0;
    font-family: var(--fuente-mano);
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--dorado);
  }
  .portada__aviso {
    display: inline-block;
    margin: 1.25rem 0 0;
    padding: 0.35rem 0.9rem;
    border: 1px solid rgb(227 183 102 / 0.6);
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--papel);
  }

  .cuerpo {
    background: var(--papel);
    color: var(--pizarron);
    padding: 1.75rem 1rem 1rem;
  }
  .cuerpo > * { max-width: 68rem; margin-inline: auto; }

  .etiqueta {
    margin-top: 0;
    margin-bottom: 0.9rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .locales {
    list-style: none;
    padding: 0;
    margin-top: 0;
    margin-bottom: 1.25rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }
  .local {
    display: flex;
    flex-direction: column;
    background: var(--tarjeta);
    border: 1px solid #e4dccd;
    border-radius: 0.9rem;
    overflow: hidden;
  }
  .local__foto {
    display: block;
    width: 100%;
    aspect-ratio: 27 / 10;
    object-fit: cover;
    background: #2a302c;
  }
  .local__cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.1rem 1.1rem 1.25rem;
  }
  .local__encabezado { display: flex; align-items: center; gap: 0.9rem; }
  .local__logo { flex: none; width: 56px; height: 56px; border-radius: 50%; }
  h3 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .local__linea { margin: 0.3rem 0 0; color: var(--texto-suave); }
  .local__linea a {
    display: inline-block;
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    color: var(--vino);
    font-weight: 600;
  }

  .local__acciones {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: 0.6rem;
  }
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.5rem;
    border-radius: 0.6rem;
    border: 2px solid transparent;
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    line-height: 1.2;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .boton--oscuro { background: var(--pizarron); color: var(--papel); }
  .boton--oscuro:hover { background: #333a35; }
  .boton--vino { background: var(--vino); color: var(--papel); }
  .boton--vino:hover { background: var(--vino-oscuro); }
  .boton--borde { border-color: var(--pizarron); color: var(--pizarron); background: transparent; }
  .boton--borde:hover { background: var(--pizarron); color: var(--papel); }

  .historia {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding: 1.1rem 1.25rem;
    background: var(--pizarron);
    color: var(--papel);
    border-radius: 0.9rem;
    text-decoration: none;
  }
  .historia:hover svg { transform: translateX(3px); }
  .historia svg { flex: none; transition: transform 0.15s ease; }
  .historia__titulo { display: block; font-family: var(--fuente-titulo); font-size: 1.35rem; line-height: 1.2; }
  .historia__bajada { display: block; margin-top: 0.15rem; color: rgb(244 238 227 / 0.85); }

  .blog { margin-top: -0.75rem; margin-bottom: 1.5rem; }
  .blog a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--vino); }

  .redes {
    list-style: none;
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: 0.6rem;
  }
  .redes a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d9d0c1;
    border-radius: 0.6rem;
    background: var(--tarjeta);
    text-decoration: none;
    font-weight: 600;
  }
  .redes a:hover { border-color: var(--pizarron); }

  .pie {
    background: var(--papel);
    color: var(--texto-suave);
    text-align: center;
    padding: 1.5rem 1rem 2.5rem;
    font-size: 0.875rem;
  }
  .pie p { margin: 0; }

  @media (min-width: 48rem) {
    .portada { padding-block: 3.5rem 3rem; }
    .cuerpo { padding-top: 2.5rem; }
    .redes { max-width: 30rem; margin-inline: 0; }
  }
</style>
