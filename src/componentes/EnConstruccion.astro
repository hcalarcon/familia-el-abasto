---
// Pantalla provisoria "en construcción", compartida por / y /cartas:
// solo el hero con el logo, el nombre y un aviso. El texto sale de src/contenido/.
import Base from '../layouts/Base.astro';
import { sitio, enConstruccion, esPendiente } from '../lib/contenido';
import { datosDelGrupo } from '../lib/seo';

interface Props {
  /** "inicio" para /, "cartas" para /cartas (la entrada del QR). */
  pantalla: 'inicio' | 'cartas';
}
const { pantalla } = Astro.props;

const mostrar = (valor: string | undefined) => (esPendiente(valor) ? '' : (valor ?? '').trim());
const logo = mostrar(sitio.logo);
const aviso = mostrar(enConstruccion.aviso);
---
<Base
  titulo={pantalla === 'cartas' ? `Cartas · ${sitio.nombre}` : `${sitio.nombre} · ${sitio.ciudad}`}
  descripcion={`${sitio.nombre}, ${sitio.ciudad}. ${sitio.historia}`}
  datosEstructurados={datosDelGrupo(Astro.site)}
>
  <main class="hero">
    {logo && <img class="hero__logo" src={logo} alt={mostrar(sitio.logoAlt)} width="140" height="131" />}
    <h1>{sitio.nombre}</h1>
    {aviso && <p class="hero__aviso">{aviso}</p>}
  </main>
</Base>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 3rem 1rem;
    text-align: center;
    background: var(--pizarron);
    color: var(--papel);
  }
  .hero__logo { display: block; width: 140px; height: auto; }
  h1 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: clamp(2rem, 10vw, 3.5rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .hero__aviso {
    margin: 0;
    padding: 0.4rem 1rem;
    border: 1px solid rgb(227 183 102 / 0.6);
    border-radius: 999px;
    font-size: 0.9375rem;
    color: var(--papel);
  }
</style>
