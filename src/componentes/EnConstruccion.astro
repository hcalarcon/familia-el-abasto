---
// Pantalla provisoria "en construcción", compartida por / y /menus.
// Todo el texto sale de src/contenido/.
import Base from '../layouts/Base.astro';
import { sitio, enConstruccion, esPendiente, linkTelefono } from '../lib/contenido';
import { obtenerPaginas, obtenerNotas } from '../lib/publicaciones';
import { datosDelGrupo } from '../lib/seo';

interface Props {
  /** "inicio" para /, "menus" para /menus (la entrada del QR). */
  pantalla: 'inicio' | 'menus';
}
const { pantalla } = Astro.props;
const [paginas, notas] = await Promise.all([obtenerPaginas(), obtenerNotas()]);
const masEnlaces = [
  ...paginas.filter((p) => p.data.enMenu).map((p) => ({ texto: p.data.titulo, href: `/${p.id}` })),
  ...(notas.length ? [{ texto: 'Blog', href: '/blog' }] : []),
];
const titulo = pantalla === 'menus' ? enConstruccion.tituloMenus : enConstruccion.titulo;

// Los datos entre corchetes siguen pendientes: no se muestran en la web.
const mostrar = (valor: string) => (esPendiente(valor) ? '' : valor);

const locales = sitio.locales.map((local) => ({
  ...local,
  descripcion: mostrar(local.descripcion),
  direccion: mostrar(local.direccion),
  horario: mostrar(local.horario),
  telefonoVisible: mostrar(local.telefono),
  tel: linkTelefono(local.telefono),
  menu: mostrar(local.menu),
}));

const redes = sitio.locales.flatMap((local) =>
  [
    { red: 'Instagram', url: mostrar(local.instagram) },
    { red: 'Facebook', url: mostrar(local.facebook) },
  ]
    .filter((r) => r.url)
    .map((r) => ({ ...r, local: local.nombre })),
);
---
<Base
  titulo={pantalla === 'menus' ? `Menús · ${sitio.nombre}` : `${sitio.nombre} · ${sitio.ciudad}`}
  descripcion={`${sitio.historia} ${enConstruccion.mensaje}`}
  datosEstructurados={datosDelGrupo(Astro.site)}
>
  <header class="portada">
    <p class="marca">
      <span class="marca__grupo">Grupo</span>
      <span class="marca__nombre">El Abasto</span>
    </p>
    <h1>{titulo}</h1>
    <p class="subtitulo">{enConstruccion.subtitulo}</p>
    {pantalla === 'inicio' ? (
      <>
        <p class="historia">{sitio.historia}</p>
        <p class="mensaje">{enConstruccion.mensaje}</p>
      </>
    ) : (
      <p class="mensaje"><a class="link-historia" href="/">Nuestra historia</a></p>
    )}
  </header>

  <main>
    <h2 class="visualmente-oculto">Nuestros locales</h2>
    <ul class="locales" role="list">
      {locales.map((local) => (
        <li class="local">
          <h3>{local.nombre}</h3>
          {local.descripcion && <p class="local__descripcion">{local.descripcion}</p>}
          <dl class="local__datos">
            {local.direccion && (
              <div><dt>Dirección</dt><dd>{local.direccion}</dd></div>
            )}
            {local.horario && (
              <div><dt>Horario</dt><dd>{local.horario}</dd></div>
            )}
            {local.telefonoVisible && (
              <div>
                <dt>Teléfono</dt>
                <dd>
                  {local.tel ? <a href={local.tel}>{local.telefonoVisible}</a> : local.telefonoVisible}
                </dd>
              </div>
            )}
          </dl>
          {(local.menu || local.tel) && (
            <div class="local__acciones">
              {local.menu && (
                <a class="boton boton--principal" href={local.menu} rel="noopener">
                  Ver menú<span class="visualmente-oculto"> de {local.nombre}</span>
                </a>
              )}
              {local.tel && (
                <a class="boton boton--secundario" href={local.tel}>
                  Reservar<span class="visualmente-oculto"> en {local.nombre} por teléfono</span>
                </a>
              )}
            </div>
          )}
        </li>
      ))}
    </ul>
  </main>

  {redes.length > 0 && (
    <footer class="pie">
      <h2 class="pie__titulo">Seguinos</h2>
      <ul class="redes" role="list">
        {redes.map((r) => (
          <li>
            <a href={r.url} rel="noopener">{r.red}<span class="pie__local">{` · ${r.local}`}</span></a>
          </li>
        ))}
      </ul>
      {masEnlaces.length > 0 && (
        <nav aria-label="Más del grupo">
          <ul class="redes" role="list">
            {masEnlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
          </ul>
        </nav>
      )}
      <p class="pie__ciudad">{sitio.ciudad}</p>
    </footer>
  )}
</Base>

<style>
  .portada, main, .pie {
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .portada {
    padding-block: 3rem 2rem;
    text-align: center;
  }
  .marca { margin: 0 0 2rem; line-height: 1; }
  .marca__grupo {
    display: block;
    font-family: var(--fuente-mano);
    font-size: 1.75rem;
    color: var(--dorado);
  }
  .marca__nombre {
    display: block;
    font-family: var(--fuente-titulo);
    font-size: clamp(2.5rem, 12vw, 4.5rem);
    letter-spacing: 0.01em;
  }
  h1 {
    margin: 0;
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: clamp(1.5rem, 6vw, 2.25rem);
    line-height: 1.15;
    color: var(--dorado);
    text-wrap: balance;
  }
  .subtitulo {
    margin: 0.25rem 0 1.5rem;
    font-family: var(--fuente-mano);
    font-size: 1.6rem;
  }
  .link-historia {
    display: inline-block;
    min-height: 44px;
    padding-block: 0.625rem;
    font-weight: 600;
    color: var(--dorado);
  }
  .historia, .mensaje {
    max-width: 36rem;
    margin: 0 auto 1rem;
    font-size: 1.0625rem;
    text-wrap: pretty;
  }

  .locales {
    list-style: none;
    margin: 0;
    padding: 0 0 3rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .local {
    display: flex;
    flex-direction: column;
    background: var(--tarjeta);
    color: var(--pizarron);
    border-radius: 0.75rem;
    box-shadow: inset 0 6px 0 var(--vino);
    padding: 1.5rem 1.25rem 1.25rem;
  }
  .local h3 {
    margin: 0 0 0.5rem;
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.15;
    color: var(--vino);
  }
  .local__descripcion { margin: 0 0 0.75rem; color: var(--texto-suave); }
  .local__datos { margin: 0 0 1rem; }
  .local__datos div { margin-bottom: 0.5rem; }
  .local__datos dt {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--texto-suave);
  }
  .local__datos dd { margin: 0; }
  .local__datos a {
    color: var(--vino);
    font-weight: 600;
    display: inline-block;
    padding-block: 0.6rem;
    margin-block: -0.6rem;
  }

  .local__acciones {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .boton {
    flex: 1 1 8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    border: 2px solid var(--vino);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .boton--principal { background: var(--vino); color: var(--papel); }
  .boton--principal:hover { background: #5f1f27; border-color: #5f1f27; }
  .boton--secundario { background: transparent; color: var(--vino); }
  .boton--secundario:hover { background: var(--vino); color: var(--papel); }

  .pie {
    padding-block: 2rem 3rem;
    border-top: 1px solid rgb(244 238 227 / 0.2);
    text-align: center;
  }
  .pie__titulo {
    margin: 0 0 0.75rem;
    font-family: var(--fuente-mano);
    font-weight: 600;
    font-size: 1.75rem;
    color: var(--dorado);
  }
  .redes {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;
  }
  .redes a {
    display: inline-block;
    min-height: 44px;
    padding: 0.625rem 0.25rem;
  }
  .pie__local { color: rgb(244 238 227 / 0.8); }
  .pie__ciudad { margin: 0; font-size: 0.875rem; color: rgb(244 238 227 / 0.8); }
</style>
